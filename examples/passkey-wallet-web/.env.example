# Copy to .env and fill in. .env is gitignored; this template is not.
#
# The sponsor backend starts only when both are set. Without them the page still
# runs and accounts stay counterfactual — nothing here picks a provider or a key
# for you.

# Any Sepolia JSON-RPC endpoint. Read and write; the sponsor sends transactions
# through it.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# A separately operated endpoint used when connecting a deployment manifest.
# It must not be the same URL as SEPOLIA_RPC_URL. The connector refuses to write
# a trusted wallet profile unless both endpoints agree on the chain, bytecode,
# and immutable factory/registry bindings.
SEPOLIA_VERIFICATION_RPC_URL=

# Official ERC-4337 v0.9 EntryPoint, pinned by DeploySepolia.s.sol as well.
SEPOLIA_ENTRYPOINT=0x433709009B8330FDa32311DF1C2AFA402eD8D009

# The key that PAYS for account creation. It is never account authority: users
# sign their own operations with their passkeys, and this key cannot alter a
# signed operation or control an account it funded.
#
# Use a throwaway key with only testnet funds. Never a key that holds anything
# you would miss, and never one reused on mainnet.
SEPOLIA_SPONSOR_PRIVATE_KEY=0x

# Factory pinned by the deployment profile. Sponsored activation refuses every
# other factory and only accepts its createAccount calldata.
SPONSOR_FACTORY=

# OnboardingPaymaster from the same deployment. Its EntryPoint deposit pays only
# an operator-authorized first activation and is charged atomically with it.
SPONSOR_PAYMASTER=
SPONSOR_POLICY_HASH=0x

# A dedicated authorization key matching OnboardingPaymaster.authorizer(). It
# can approve gas sponsorship but cannot control any user account.
SPONSOR_AUTHORIZER_PRIVATE_KEY=0x
# SPONSOR_PAYMASTER_VERIFICATION_GAS=150000
# SPONSOR_PAYMASTER_POSTOP_GAS=1
# SPONSOR_PRE_VERIFICATION_GAS_BUFFER=50000

# A private-transaction endpoint (for example a protected RPC that accepts
# eth_sendRawTransaction without broadcasting it to the public mempool). It
# must be distinct from SEPOLIA_RPC_URL, which remains the independent read and
# receipt endpoint.
SPONSOR_PRIVATE_RPC_URL=

# Stable, operator-selected policy identifier. It is also written into the web
# deployment profile so the client and relay must agree before any funds move.
# SPONSOR_POLICY_ID=loom-sepolia-onboarding-v1

# Hard spend and request-shape limits. Must match the paymaster's immutable
# policy hash and maximumCost.
# SPONSOR_MAX_COST_WEI=5000000000000000
# SPONSOR_GLOBAL_BUDGET_WEI=100000000000000000
# SPONSOR_MAX_FACTORY_DATA_BYTES=8192
# SPONSOR_MAX_SIGNATURE_BYTES=4096
# SPONSOR_MAX_ACTIVATIONS_PER_PRINCIPAL=3
# SPONSOR_WINDOW_SECONDS=86400

# Optional. Defaults shown.
# SPONSOR_PORT=8787
# Exact browser origin allowed to call the development relay. It must match the
# loopback origin serving the wallet page, which `npm run dev` puts on port
# 5174. Remote browser origins are rejected even though the relay itself binds
# loopback. A request that carries no Origin header at all is refused too: the
# relay pays for whoever it accepts, so it declines callers it cannot identify.
# SPONSOR_ALLOWED_ORIGIN=http://localhost:5174

# Interface the reference relay binds. Only loopback values are accepted. A
# production service must supply its own authenticated per-principal gateway
# and durable transactional quota/idempotency ledger.
# SPONSOR_HOST=127.0.0.1
